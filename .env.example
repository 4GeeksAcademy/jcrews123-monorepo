# Canonical env for Docker Compose (services + uis containers).
# Copy to .env at this repo root: cp .env.example .env
#
# Browser requests use the backoffice same-origin proxy.
NEXT_PUBLIC_API_URL=/backend

# Resolved only by the Next.js process inside the Docker network.
INTERNAL_API_URL=http://services:8000
WATCHPACK_POLLING=true

# FastAPI authentication
SECRET_KEY=replace-with-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=60
RESET_TOKEN_EXPIRE_MINUTES=30

# Host-facing link included in password-reset emails
FRONTEND_RESET_URL=http://localhost:3001/reset-password
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Supabase Postgres (transaction pooler recommended from Docker on Windows).
# Supabase UI shows postgresql:// — use postgresql+psycopg2:// for this API (psycopg2-binary).
# Example shape (replace password; URL-encode special chars in password, e.g. # -> %23):
# DATABASE_URL=postgresql+psycopg2://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Optional TinyDB locations (defaults already work inside the source mount)
USERS_DB_PATH=/workspace/services/api/data/users.json
SUPPLIERS_DB_PATH=/workspace/services/api/data/suppliers.json
