# Local uvicorn only (python -m uvicorn main:app from this folder).
# Docker Compose loads the repo ROOT .env instead — keep DATABASE_URL and SECRET_KEY
# in sync in both places if you use Docker and local API runs.
#
# Same postgresql+psycopg2:// rule as root .env.example (not plain postgresql://).
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
RESET_TOKEN_EXPIRE_MINUTES=30
FRONTEND_RESET_URL=http://localhost:3001/reset-password
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
DATABASE_URL=
